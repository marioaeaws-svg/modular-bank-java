<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logs (Paso 4, see ADR-009). All MDC entries are included as
  top-level fields automatically — traceId/spanId are populated by Micrometer
  Tracing whenever a span is active; userId/transferId/eventId are added
  explicitly at request/message entry points (JwtAuthFilter, transfer-event
  listeners) so a single field lets you filter every log line for one
  business operation.
-->
<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${serviceName}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
