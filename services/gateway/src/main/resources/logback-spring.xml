<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logs (Paso 4, see ADR-009). traceId/spanId are populated
  automatically by Micrometer Tracing (propagated via Reactor context to MDC
  since Spring Boot 3.2's automatic context propagation, enabled once
  io.micrometer:context-propagation is on the classpath — pulled transitively
  by micrometer-tracing-bridge-otel).
-->
<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${serviceName}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
